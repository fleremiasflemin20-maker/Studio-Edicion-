{
  "name": "fleremahias-studio",
  "main": "studio.mjs",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "services": [{ "binding": "PRIVATE_SERVICE", "service": "luma-studio-service" }],
  "observability": { "enabled": false },
}
