{
  "name": "fleremahias-studio",
  "main": "studio.mjs",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },
  "d1_databases": [
    {
      "binding": "LIBRARY_DB",
      "database_name": "fleremahias-library",
      "database_id": "0ecab470-8c71-43ef-af33-aee097b1cbe4",
    },
  ],
  "r2_buckets": [
    { "binding": "LIBRARY_MEDIA", "bucket_name": "fleremahias-library" },
    { "binding": "REVIEW_MEDIA", "bucket_name": "fleremahias-reviews" },
  ],
  "vars": {
    "CATALOG_ADMIN_ORIGINS": "https://fleremahias-studio.analista-datos-pro.workers.dev,https://fleremiasflemin20-maker.github.io,https://luma-social-studio-251026.keenox19.chatgpt.site,http://127.0.0.1:4182,http://127.0.0.1:4183",
  },
  "services": [{ "binding": "PRIVATE_SERVICE", "service": "luma-studio-service" }],
  "observability": { "enabled": false },
}
