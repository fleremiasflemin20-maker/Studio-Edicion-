{
  "name": "luma-social-studio",
  "version": "4.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node server.cjs",
    "test": "node --test tests/core.test.cjs tests/creator-core.test.cjs tests/pro-core.test.cjs",
    "check": "node scripts/check.cjs",
    "format": "prettier --write \"dist/**/*.{js,css,html}\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\" server.cjs README.md package.json",
    "format:check": "prettier --check \"dist/**/*.{js,css,html}\" \"tests/**/*.cjs\" \"scripts/**/*.cjs\" server.cjs README.md package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
